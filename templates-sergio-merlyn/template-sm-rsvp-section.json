{"id": 392, "name": "sm-rsvp-section-2", "title": "SM RSVP Section", "date": "2026-05-24 23:10:31", "date_formatted": "May 24, 2026", "author": {"name": "info@bodacervantessoto.upbox.xyz", "avatar": "https://secure.gravatar.com/avatar/3ff1438fd51d44bd9b68b20a9e4a32712432daf69e62f88909f103ab251dcd53?s=60&d=mm&r=g", "url": "http://bodacervantessoto.upbox.xyz"}, "permalink": "https://bodacervantessoto.upbox.xyz/template/sm-rsvp-section-2/", "thumbnail": null, "bundles": [], "tags": [], "type": "section", "content": [{"id": "a94b61", "name": "section", "parent": 0, "children": ["481711"], "settings": {"_background": {"color": {"raw": "#1a2f4a"}}}, "label": "SM RSVP Section"}, {"id": "481711", "name": "container", "parent": "a94b61", "children": ["a0e112", "e2b7c9", "de52ed", "59d948"], "settings": {"_padding": {"top": "80", "bottom": "80", "left": "24", "right": "24"}, "_alignItems": "center", "_direction": "column", "_rowGap": "20"}}, {"id": "a0e112", "name": "text-basic", "parent": "481711", "children": [], "settings": {"text": "Confirma tu asistencia", "tag": "p", "_typography": {"font-family": "Inter", "font-size": "1.1rem", "letter-spacing": "0.32em", "text-transform": "uppercase", "color": {"id": "qufsve", "raw": "var(--gold)", "light": "#c9a961"}, "text-align": "center"}}}, {"id": "e2b7c9", "name": "heading", "parent": "481711", "children": [], "settings": {"text": "¿Contamos <em>contigo</em>?", "tag": "h2", "_typography": {"font-family": "Italiana", "font-weight": "400", "font-size": "7.2rem", "color": {"id": "mctesc", "raw": "var(--paper)", "light": "#faf7f2"}, "text-align": "center"}, "_margin": {"bottom": "0"}, "_cssGlobalClasses": ["koypyo"]}}, {"id": "de52ed", "name": "text", "parent": "481711", "children": [], "settings": {"text": "<p><span id=\"sm-rsvp-guest-name\">Familia García López</span>, tu presencia será para nosotros el mejor regalo.<br />Por favor confírmanos antes del <em>15 de octubre</em>.</p>\n<p>Si no recibimos tu confirmación antes de esa fecha, entenderemos con mucho cariño que no podrás acompañarnos en esta ocasión.</p>", "_typography": {"font-family": "Cormorant Garamond", "font-size": "2.1rem", "line-height": "1.65", "color": {"id": "mctesc", "raw": "var(--paper)", "light": "#faf7f2"}, "text-align": "center"}, "_cssGlobalClasses": ["koypyo"], "_width": "100%", "_widthMax": "520"}}, {"id": "59d948", "name": "block", "parent": "481711", "children": ["372d93"], "settings": {"_width": "100%", "_widthMax": "600", "_padding": {"top": "32", "bottom": "32", "left": "32", "right": "32"}, "_typography": {"text-align": "center"}}}, {"id": "372d93", "name": "code", "parent": "59d948", "children": [], "settings": {"code": "<form class=\"sm-rsvp-form\" id=\"sm-rsvp-form\" onsubmit=\"return false\">\n  <div>\n    <span class=\"sm-field-label\">¿Asistirán?</span>\n    <div class=\"sm-choices\">\n      <button type=\"button\" class=\"sm-choice\" data-val=\"Sí, ahí estaremos\">Sí, ahí estaremos</button>\n      <button type=\"button\" class=\"sm-choice\" data-val=\"No podremos asistir\">No podremos asistir</button>\n    </div>\n  </div>\n  <div>\n    <label class=\"sm-field-label\" for=\"sm-nombre\">Nombre</label>\n    <input type=\"text\" id=\"sm-nombre\" placeholder=\"Tu nombre\" />\n  </div>\n  <input type=\"hidden\" id=\"sm-asistencia\" value=\"\" />\n  <button type=\"submit\" class=\"sm-submit\" id=\"sm-submit-btn\" disabled>Enviar confirmación</button>\n</form>\n<div class=\"sm-rsvp-success\" id=\"sm-rsvp-success\">¡Gracias! Hemos recibido tu confirmación.<br>¡Nos vemos el 7 de noviembre!</div>\n<script>\ndocument.addEventListener(\"DOMContentLoaded\", function(){\n  var params       = new URLSearchParams(window.location.search);\n  var urlNombre    = params.get(\"nombre\") || \"\";\n  var nombreEl     = document.getElementById(\"sm-nombre\");\n  var choices      = document.querySelectorAll(\".sm-choice\");\n  var submitBtn    = document.getElementById(\"sm-submit-btn\");\n  var form         = document.getElementById(\"sm-rsvp-form\");\n  var successEl    = document.getElementById(\"sm-rsvp-success\");\n  var asistenciaEl = document.getElementById(\"sm-asistencia\");\n\n  if (urlNombre && nombreEl) nombreEl.value = urlNombre;\n\n  choices.forEach(function(btn) {\n    btn.addEventListener(\"click\", function() {\n      choices.forEach(function(b) { b.classList.remove(\"selected\"); });\n      this.classList.add(\"selected\");\n      if (asistenciaEl) asistenciaEl.value = this.getAttribute(\"data-val\");\n      if (submitBtn) {\n        submitBtn.removeAttribute(\"disabled\");\n        submitBtn.classList.add(\"ready\");\n      }\n    });\n  });\n\n  if (form) {\n    form.addEventListener(\"submit\", function() {\n      var nombre     = nombreEl ? nombreEl.value : urlNombre;\n      var asistencia = asistenciaEl ? asistenciaEl.value : \"\";\n      var fd = new FormData();\n      fd.append(\"action\",     \"sm_rsvp_send\");\n      fd.append(\"nombre\",     nombre);\n      fd.append(\"asistencia\", asistencia);\n      fd.append(\"nonce\",      (window.smRsvp && window.smRsvp.nonce) || \"\");\n      fetch((window.smRsvp && window.smRsvp.ajaxUrl) || \"/wp-admin/admin-ajax.php\", {\n        method: \"POST\", body: fd\n      }).catch(function(){}).finally(function() {\n        form.style.display = \"none\";\n        if (successEl) successEl.style.display = \"block\";\n      });\n    });\n  }\n});\n<\\/script>", "executeCode": true, "user_id": 1, "time": 1779685339, "_cssCustom": ".sm-rsvp-form { display:flex; flex-direction:column; gap:20px; }\n.sm-rsvp-form .sm-field-label { font-family:'Inter',system-ui,sans-serif; font-size:1.1rem; letter-spacing:0.25em; text-transform:uppercase; color:var(--gold); display:block; margin-bottom:16px; }\n\n.sm-rsvp-form .sm-choices { \n  display:flex;\n  gap:12px;\n  flex-wrap:wrap;\n  justify-content: center;\n}\n\n.sm-rsvp-form .sm-choice {\n  font-family:'Cormorant Garamond','Times New Roman',serif;\n  flex: 1 1 200px;\n  max-width: 240px;\n  background: transparent;\n  border: 1px solid rgba(250, 247, 242, .35);\n  color: var(--paper);\n  padding: 16px 20px;\n  font-size: 1.7rem;\n  font-style: italic;\n  cursor: pointer;\n  transition: all .3s ease;\n}\n.sm-rsvp-form .sm-choice.selected,.sm-rsvp-form .sm-choice:hover { background:rgba(201,169,97,0.2); border-color:#c9a961; color:#faf7f2; }\n.sm-rsvp-form input[type=text],.sm-rsvp-form input[type=email],.sm-rsvp-form input[type=number] { width:100%; background:rgba(250,247,242,0.06); border:1px solid rgba(250,247,242,0.2); color:#faf7f2; font-family:'Cormorant Garamond','Times New Roman',serif; font-size:1.05rem; padding:10px 14px; border-radius:2px; box-sizing:border-box; }\n.sm-rsvp-form input::placeholder { color:rgba(250,247,242,0.35); }\n.sm-rsvp-form .sm-submit { \n  margin-top: 20px;\n  background: transparent;\n  border: 1px solid var(--gold);\n  color: var(--gold);\n  padding: 16px 28px;\n  letter-spacing: .4em;\n  text-transform: uppercase;\n  font-family: Inter;\n  font-size: 11px;\n  cursor: pointer;\n  transition: background .3s, color .3s;\n}\n\n.sm-rsvp-form .sm-submit:hover {\n  background: var(--gold);\n  color: var(--ink);\n}\n.sm-rsvp-form .sm-submit.ready { opacity:1; pointer-events:auto; }\n.sm-rsvp-success { display:none; text-align:center; font-family:'Cormorant Garamond','Times New Roman',serif; font-size:1.3rem; color:#d9bd82; padding:24px 0; }\n"}}], "templateType": "section", "global_classes": [{"id": "koypyo", "name": "highlight--em", "settings": {"_cssCustom": ".highlight--em em {color:var(--gold);}"}}], "globalVariables": [{"id": "azcwzo", "name": "text-2xs", "value": "clamp(0.82rem, calc(0.00018518518518518534 * (100vw - 36rem) + 0.82rem), 0.84rem)", "category": "fahlau", "scale": {"scale": -3, "scaleName": "2xs"}}, {"id": "ijmjuo", "name": "text-xs", "value": "clamp(1.02rem, calc(0.0010185185185185173 * (100vw - 36rem) + 1.02rem), 1.13rem)", "category": "fahlau", "scale": {"scale": -2, "scaleName": "xs"}}, {"id": "erlkyl